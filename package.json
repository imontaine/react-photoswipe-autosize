{
  "name": "react-photoswipe-autosize",
  "version": "1.0.5",
  "description": "Drop-in auto-sizing for react-photoswipe-gallery — no width/height props needed",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "photoswipe": "^5.0.0",
    "react": ">=17.0.0",
    "react-photoswipe-gallery": ">=2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "photoswipe": "^5.4.4",
    "react": "^19.0.0",
    "react-photoswipe-gallery": "^3.0.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "photoswipe",
    "react",
    "gallery",
    "lightbox",
    "auto-size",
    "dimensions",
    "react-photoswipe-gallery"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imontaine/react-photoswipe-autosize.git"
  }
}
